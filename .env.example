# ==============================================================================
# ApprovalTrack Environment Configuration
# ==============================================================================

# Application
APP_NAME=ApprovalTrack
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=aicte_super_secret_jwt_key_approvaltrack_sih_2026_tech_spark
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL default, falls back to SQLite for local lightweight testing)
# In Docker: postgresql+asyncpg://postgres:postgres@db:5432/approvaltrack
# Local SQLite default: sqlite+aiosqlite:///./approvaltrack.db
DATABASE_URL=sqlite+aiosqlite:///./approvaltrack.db
DATABASE_SYNC_URL=sqlite:///./approvaltrack.db

# Redis & Celery
# In Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Mail / SMTP (MailHog in dev)
# In Docker: mailhog:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@approvaltrack.gov.in
SMTP_FROM_NAME="AICTE ApprovalTrack"

# File Storage & Uploads
STORAGE_DIR=d:/SIH10/uploads
MAX_FILE_SIZE_MB=15

# OCR Settings
TESSERACT_CMD=tesseract

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Seed Data on Startup
SEED_ON_START=true

